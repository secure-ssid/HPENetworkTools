{
  "name": "hpe-network-tools",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "npm run build -w web && concurrently -n web-build,server -c blue,magenta \"npm run build -w web -- --watch\" \"npm run dev -w server\"",
    "start": "npm start -w server",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
