{
  "name": "hpe-network-tools",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "npm run build -w web && concurrently -n web-build,server -c blue,magenta \"npm run build -w web -- --watch\" \"npm run dev -w server\"",
    "start": "npm start -w server",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "typescript-eslint": "^8.65.0"
  }
}
